{
  "name": "strongcode",
  "version": "0.1.0",
  "description": "A secure terminal-first local agent harness with one-time model-provider onboarding.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "README.md",
    "strongcode.config.example.yaml",
    "Code Smarter.gif"
  ],
  "bin": {
    "strongcode": "dist/cli.js"
  },
  "scripts": {
    "postinstall": "node -e \"console.log('StrongCode installed. Run strongcode setup to make the harness ready.')\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentui/core": "^0.3.1",
    "@opentui/keymap": "^0.3.1",
    "@opentui/solid": "^0.3.1",
    "@vscode/ripgrep": "^1.18.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "solid-js": "^1.9.12",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
